# Scripts com dados pessoais dos respondentes das consultas.
# São gerados sob demanda e executados direto no Supabase — NUNCA versionar,
# porque este repositório é público e o histórico do Git é permanente.
db/consulta-respondentes.sql
db/*-respondentes.sql
db/*-nominal.sql

# ── Dados: NUNCA versionar (repositorio publico) ──────────────────────────
*.sql
*.csv
*.dump
*.xlsx
*.xls
.env
.env.*
!.env.example

# ── Dados: NUNCA versionar (repositório público) ─────────────────────────────
# Script de carga e export carregam dado real junto, quase sempre sem quem
# escreveu perceber. Entregue-os fora do repositório, para rodar no SQL Editor.
# ⚠️ O .gitignore NÃO destrava arquivo já rastreado, e NÃO apaga o histórico.
*.tsv
*.sqlite
*.sqlite3
*.parquet
*.xlsm
*.mdb
*.accdb
